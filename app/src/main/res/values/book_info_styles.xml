<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BookInfo" />

    <style name="BookInfo.Section">
        <item name="android:background">@drawable/bg_book_info_section</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="BookInfo.DetailColumns">
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BookInfo.IdentityColumn" parent="BookInfo.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BookInfo.IdentityCover">
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="BookInfo.IdentityText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="BookInfo.DetailsColumn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="BookInfo.Heading">
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BookInfo.MetadataRow">
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="BookInfo.MetadataIcon">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="tint">@color/secondaryText</item>
    </style>

    <style name="BookInfo.MetadataText">
        <item name="android:layout_weight">1</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BookInfo.Action">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BookInfo.Action.Secondary">
        <item name="android:background">@drawable/bg_book_info_secondary_action</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="BookInfo.Action.Primary">
        <item name="android:background">@drawable/bg_book_info_primary_action</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="BookInfo.Field">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_control</item>
        <item name="boxStrokeColor">@color/book_info_field_stroke</item>
        <item name="boxBackgroundColor">@color/background_card</item>
        <item name="android:textColorHint">@color/secondaryText</item>
        <item name="hintTextColor">@color/accent</item>
    </style>

    <style name="BookInfo.FieldText">
        <item name="android:background">@null</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">16sp</item>
    </style>

    <string name="book_info_reading_details">Reading details</string>
    <string name="book_info_empty_intro">No description available</string>
    <string name="book_info_chapter_progress">Chapter %1$d of %2$d</string>
    <string name="book_info_cover_options">Cover options</string>
    <string name="book_info_hide_cover_options">Hide cover options</string>
</resources>
