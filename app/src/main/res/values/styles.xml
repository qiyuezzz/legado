<resources>

    //**************************************************************Theme******************************************************************************//

    <!-- 亮色主题 -->
    <style name="AppTheme.Light" parent="Base.AppTheme">
        <item name="actionBarStyle">@style/AppTheme.AppBarOverlay.Light</item>
    </style>

    <!-- 暗色主题 -->
    <style name="AppTheme.Dark" parent="Base.AppTheme">
        <item name="actionBarStyle">@style/AppTheme.AppBarOverlay.Dark</item>
    </style>

    <!-- 透明主题 -->
    <style name="AppTheme.Transparent" parent="Base.AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Welcome主题 -->
    <style name="AppTheme.Welcome" parent="Base.AppTheme">
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.WhitePages" parent="">
        <item name="pageBackground">@android:color/white</item>
        <item name="bookInfoSectionStroke">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.EInk" parent="">
        <item name="viewInflaterClass">io.legado.app.lib.theme.EInkViewInflater</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="selectableItemBackground">@android:color/transparent</item>
        <item name="android:selectableItemBackground">@android:color/transparent</item>
        <item name="selectableItemBackgroundBorderless">@android:color/transparent</item>
        <item name="android:selectableItemBackgroundBorderless">@android:color/transparent</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="actionOverflowMenuStyle">@style/Style.PopupMenu.EInk</item>
        <item name="popupMenuStyle">@style/Style.PopupMenu.EInk</item>
        <item name="android:popupMenuStyle">@style/Style.PopupMenu.EInk</item>
        <item name="listPopupWindowStyle">@style/Style.ListPopupWindow.EInk</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="colorControlNormal">@android:color/black</item>
        <item name="mutedIconColor">@android:color/black</item>
        <item name="bookInfoSectionStroke">@android:color/black</item>
        <item name="uiDividerColor">@android:color/black</item>
        <item name="uiDividerHeight">1dp</item>
        <item name="uiBorderColor">@android:color/black</item>
        <item name="uiCardStrokeColor">@android:color/black</item>
        <item name="uiControlStrokeColor">@android:color/black</item>
        <item name="uiControlFillColor">@android:color/white</item>
        <item name="uiSubtleFillColor">@android:color/white</item>
        <item name="uiPanelStrokeColor">@android:color/black</item>
        <item name="uiEditStrokeColor">@android:color/black</item>
        <item name="uiRippleColor">@android:color/transparent</item>
        <item name="outlinedFieldStroke">@android:color/black</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="pageBackground">@color/background</item>
        <item name="bookInfoSectionStroke">@color/transparent10</item>
        <item name="mutedIconColor">@color/icon_muted</item>
        <item name="uiDividerColor">@color/surface_divider</item>
        <item name="uiDividerHeight">0.5dp</item>
        <item name="uiBorderColor">@color/bg_divider_line</item>
        <item name="uiCardStrokeColor">@android:color/transparent</item>
        <item name="uiControlStrokeColor">@android:color/transparent</item>
        <item name="uiControlFillColor">@color/surface_canvas</item>
        <item name="uiSubtleFillColor">@color/transparent10</item>
        <item name="uiPanelStrokeColor">@android:color/transparent</item>
        <item name="uiEditStrokeColor">@color/btn_bg_press</item>
        <item name="uiRippleColor">@color/surface_card_pressed</item>
        <item name="outlinedFieldStroke">@color/book_info_field_stroke</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="actionOverflowMenuStyle">@style/Style.PopupMenu</item>
        <item name="android:itemTextAppearance">@style/Style.MenuItemText</item>
        <item name="popupMenuStyle">@style/Style.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Style.ListPopupWindow</item>
        <item name="dropDownListViewStyle">@style/Style.PopupList</item>
        <item name="android:dropDownListViewStyle">@style/Style.PopupList</item>
        <item name="android:popupMenuStyle">@style/Style.PopupMenu</item>
        <item name="spinnerStyle">@style/Style.Spinner</item>
        <item name="android:spinnerStyle">@style/Style.Spinner</item>
        <item name="android:spinnerItemStyle">@style/Style.SpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/Style.SpinnerDropDownItem</item>
        <item name="dropdownListPreferredItemHeight">44dp</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay.Light" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorAccent">@color/md_grey_900</item>
    </style>

    <style name="AppTheme.AppBarOverlay.Dark" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorAccent">@color/md_grey_50</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="popupMenuStyle">@style/Style.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Style.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Style.ListPopupWindow</item>
        <item name="dropDownListViewStyle">@style/Style.PopupList</item>
        <item name="overlapAnchor">false</item>
        <item name="colorAccent">@color/md_grey_900</item>
    </style>

    <style name="Spinner" parent="ThemeOverlay.AppCompat.Light">
        <item name="spinnerStyle">@style/Style.Spinner</item>
        <item name="android:spinnerStyle">@style/Style.Spinner</item>
        <item name="popupMenuStyle">@style/Style.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Style.ListPopupWindow</item>
        <item name="dropDownListViewStyle">@style/Style.PopupList</item>
        <item name="android:dropDownListViewStyle">@style/Style.PopupList</item>
        <item name="android:spinnerItemStyle">@style/Style.SpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/Style.SpinnerDropDownItem</item>
        <item name="dropdownListPreferredItemHeight">44dp</item>
    </style>

    //**********System Style******************//

    <style name="Style.NavigationView" parent="android:Widget">
        <item name="android:listPreferredItemHeightSmall">44dp</item>
    </style>

    <style name="Style.Toolbar.NoPadding" parent="Base.Widget.AppCompat.Toolbar">
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <style name="Style.MenuItemText" parent="@android:style/TextAppearance.Widget.IconMenu.Item">
        <item name="android:textColor">@color/menu_color_default</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Style.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">@dimen/floating_panel_elevation</item>
    </style>

    <style name="Style.PopupMenu.EInk" parent="Style.PopupMenu">
        <item name="android:popupElevation">0dp</item>
        <item name="android:popupAnimationStyle">@null</item>
    </style>


    <style name="Style.ListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">@dimen/floating_panel_elevation</item>
    </style>

    <style name="Style.ListPopupWindow.EInk" parent="Style.ListPopupWindow">
        <item name="android:popupElevation">0dp</item>
        <item name="android:popupAnimationStyle">@null</item>
    </style>

    <style name="Style.PopupList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:listSelector">@drawable/bg_popup_item</item>
        <item name="android:divider">@null</item>
    </style>

    <style name="Style.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">@dimen/floating_panel_elevation</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="overlapAnchor">false</item>
        <item name="popupTheme">@style/Spinner</item>
    </style>

    <style name="Style.SpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Style.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:checkMark">@null</item>
    </style>

    <style name="Activity.Permission" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ToolbarTitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
    </style>

    //*******************Widget Style**********************************//

    <style name="ModernListAction">
        <item name="android:background">@drawable/selector_fillet_btn_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ModernOutlinedField">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_control</item>
        <item name="boxStrokeColor">?attr/outlinedFieldStroke</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="android:textColorHint">@color/secondaryText</item>
    </style>

    <style name="Style.Shadow.Top" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/shadow_height</item>
        <item name="android:background">@drawable/bg_shadow_top</item>
    </style>

    <style name="Style.Shadow.Bottom" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/shadow_height</item>
        <item name="android:background">@drawable/bg_shadow_bottom</item>
    </style>


    <style name="Style.Line" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/uiDividerHeight</item>
        <item name="android:background">?attr/uiDividerColor</item>
    </style>

    <style name="Style.Text.Primary.Normal" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/font_size_normal</item>
        <item name="android:textColor">#000</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Style.Text.Primary.Normal.Wrap">
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="Style.Text.Second.Normal" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/font_size_normal</item>
        <item name="android:textColor">#676767</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Style.Text.Second.Normal.Wrap">
        <item name="android:layout_width">wrap_content</item>
    </style>

</resources>
