<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/player_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <io.legado.app.ui.widget.image.FilletImageView
                android:id="@+id/iv_cover"
                android:layout_width="168dp"
                android:layout_height="224dp"
                android:layout_marginVertical="16dp"
                android:contentDescription="@string/img_cover"
                android:scaleType="centerCrop"
                app:radius="@dimen/corner_radius_control" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_card_view"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_fillet_btn"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/primaryText"
                        android:visibility="invisible"
                        app:drawableStartCompat="@drawable/ic_timer_black_24dp"
                        app:drawableTint="@color/primaryText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_fillet_btn"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/primaryText"
                        android:visibility="invisible" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sub_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:textColor="@color/primaryText"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/tv_dur_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/secondaryText"
                    tools:ignore="HardcodedText" />

                    <io.legado.app.lib.theme.view.ThemeSeekBar
                        android:id="@+id/player_progress"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_all_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/secondaryText"
                    tools:ignore="HardcodedText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_skip_previous"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/skip_previous"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_skip_previous"
                        app:tint="@color/primaryText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_fast_rewind"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/fast_rewind"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_fast_rewind"
                        app:tint="@color/primaryText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fab_play_stop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/audio_play"
                            app:backgroundTint="@color/accent"
                            app:elevation="0dp"
                            app:fabSize="normal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:pressedTranslationZ="0dp"
                            app:srcCompat="@drawable/ic_play_24dp"
                            app:tint="@color/primary" />

                        <io.legado.app.lib.theme.view.ThemeProgressBar
                            android:id="@+id/progress_loading"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="invisible"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_fast_forward"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/fast_forward"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_fast_forward"
                        app:tint="@color/primaryText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_skip_next"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/skip_next"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_skip_next"
                        app:tint="@color/primaryText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_play_mode"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/play_mode"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_play_mode_list_end_stop"
                        app:tint="@color/primaryText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_timer"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/set_timer"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_timer_black_24dp"
                        app:tint="@color/primaryText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <io.legado.app.ui.widget.image.ImageButton
                        android:id="@+id/iv_chapter"
                        style="@style/ModernListAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/chapter_list"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_chapter_list"
                        app:tint="@color/primaryText" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
