<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackground"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/book_info" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.legado.app.ui.widget.NoChildScrollNestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    style="@style/BookInfo.DetailColumns"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="840dp">

                    <LinearLayout
                        style="@style/BookInfo.IdentityColumn"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            style="@style/BookInfo.IdentityCover"
                            android:layout_width="84dp"
                            android:layout_height="118dp"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="@dimen/corner_radius_media"
                            app:cardElevation="0dp">

                            <io.legado.app.ui.widget.image.CoverImageView
                                android:id="@+id/iv_cover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/img_cover"
                                android:scaleType="centerCrop"
                                android:src="@drawable/image_cover_default" />

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            style="@style/BookInfo.IdentityText"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="start|center_vertical"
                                android:maxLines="2"
                                android:textColor="@color/primaryText"
                                android:textSize="20sp"
                                tools:text="@string/book_name" />

                            <TextView
                                android:id="@+id/tv_author"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="?attr/selectableItemBackground"
                                android:ellipsize="end"
                                android:gravity="start|center_vertical"
                                android:maxLines="1"
                                android:textColor="@color/secondaryText"
                                android:textSize="14sp"
                                tools:text="@string/author" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:scrollbars="none">

                                <io.legado.app.ui.widget.LabelsBar
                                    android:id="@+id/lb_kind"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />

                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/tv_chapter_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/accent"
                                android:textSize="13sp"
                                android:visibility="gone" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        style="@style/BookInfo.DetailsColumn"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/BookInfo.Section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                style="@style/BookInfo.Heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/book_intro" />

                            <TextView
                                android:id="@+id/tv_intro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingExtra="5dp"
                                android:textColor="@color/secondaryText"
                                android:textIsSelectable="true"
                                android:textSize="15sp"
                                tools:text="@string/book_info_empty_intro" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/BookInfo.Section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                style="@style/BookInfo.Heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/book_info_reading_details" />

                            <LinearLayout
                                style="@style/BookInfo.MetadataRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.appcompat.widget.AppCompatImageView
                                    style="@style/BookInfo.MetadataIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_web_outline" />

                                <TextView
                                    android:id="@+id/tv_origin"
                                    style="@style/BookInfo.MetadataText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    tools:text="@string/origin_format" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/tv_change_source"
                                    style="@style/BookInfo.Action.Secondary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="128dp"
                                    android:shadowRadius="0"
                                    android:text="@string/change_origin" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/ll_lasted"
                                style="@style/BookInfo.MetadataRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.appcompat.widget.AppCompatImageView
                                    style="@style/BookInfo.MetadataIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_book_last" />

                                <TextView
                                    android:id="@+id/tv_lasted"
                                    style="@style/BookInfo.MetadataText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    tools:text="@string/read_dur_progress" />

                            </LinearLayout>

                            <LinearLayout
                                style="@style/BookInfo.MetadataRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.appcompat.widget.AppCompatImageView
                                    style="@style/BookInfo.MetadataIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_groups" />

                                <TextView
                                    android:id="@+id/tv_group"
                                    style="@style/BookInfo.MetadataText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    tools:text="@string/group_s" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/tv_change_group"
                                    style="@style/BookInfo.Action.Secondary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="128dp"
                                    android:shadowRadius="0"
                                    android:text="@string/change_group" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/ll_toc"
                                style="@style/BookInfo.MetadataRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.appcompat.widget.AppCompatImageView
                                    style="@style/BookInfo.MetadataIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_folder_open" />

                                <TextView
                                    android:id="@+id/tv_toc"
                                    style="@style/BookInfo.MetadataText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    tools:text="@string/toc_s" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/tv_toc_view"
                                    style="@style/BookInfo.Action.Secondary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="128dp"
                                    android:shadowRadius="0"
                                    android:text="@string/view_toc" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </io.legado.app.ui.widget.NoChildScrollNestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="?attr/uiDividerHeight"
        android:background="?attr/uiDividerColor" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_card">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="720dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tv_shelf"
                style="@style/BookInfo.Action.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:shadowRadius="0"
                android:text="@string/add_to_bookshelf" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tv_read"
                style="@style/BookInfo.Action.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:shadowRadius="0"
                android:text="@string/reading" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
